#!/bin/sh
set -e

# Versions <= 0.1.2 shipped the udev rule as a conffile at 99-...rules with
# MODE=0666; it was renamed to 70-...rules with 0660. Without this, dpkg
# leaves the obsolete 0666 rule on disk, and it overrides the new one.
dpkg-maintscript-helper rm_conffile \
    /lib/udev/rules.d/99-antec-flux-pro-display.rules 0.1.3~ -- "$@"

#DEBHELPER#
